{
  "manifest_version": 3,
  "name": "Collabia",
  "version": "1.1",
  "description": "Custom style",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://collabia.tdt.asia/*"],
  "action": {
    "default_title": "CSS Override"
  },
  "web_accessible_resources": [
    {
      "matches": ["https://collabia.tdt.asia/*"],
      "resources": ["help.html", "image/bg.png", "image/chat-frame-bg.png", "image/dotted.png", "image/qr/*", "clock/index.html"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://collabia.tdt.asia/*"],
      "run_at": "document_idle",
      "css": ["style.css"],
      "js": ["global.js", "utils.js", "localforage.js", "script.js", "helpscript.js", "curl.js"]
    }
  ]
}
